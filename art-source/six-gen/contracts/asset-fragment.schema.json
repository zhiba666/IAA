{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iaa:six-generation:asset-fragment:1",
  "title": "IAA six-generation artwork manifest fragment (candidate staging, not runtime manifest)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "baseCommit",
    "owner",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "owner": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5",
        "A6",
        "A7"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "category",
        "stageUse",
        "file",
        "width",
        "height",
        "anchor",
        "sourceFile",
        "sha256",
        "provenanceRef",
        "reuseSource"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z_]+$"
        },
        "status": {
          "enum": [
            "PLANNED",
            "GENERATED",
            "EXPORTED",
            "VERIFIED_ART"
          ]
        },
        "category": {
          "enum": [
            "machine",
            "logistics",
            "product",
            "ui",
            "scene",
            "fx"
          ]
        },
        "stageUse": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenanceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "reuseSource": {
          "type": [
            "string",
            "null"
          ]
        },
        "alphaMode": {
          "enum": [
            "RGBA",
            "opaque-background",
            "TBD"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "EXPORTED",
                  "VERIFIED_ART"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "file": {
                "type": "string",
                "pattern": ".*\\.png$"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "anchor": {
                "$ref": "#/$defs/point"
              },
              "sourceFile": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "provenanceRef": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
